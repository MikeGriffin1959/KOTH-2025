# Redirect the bare host root (/) to the app's context path (/KOTH/).
# The app deploys at context /KOTH, so requests to "/" would otherwise 404.
# Implemented as ALB listener rules on both the HTTP(80) and HTTPS(443) listeners.
Resources:
  RootRedirectRuleHttp:
    Type: AWS::ElasticLoadBalancingV2::ListenerRule
    Properties:
      ListenerArn:
        Ref: AWSEBV2LoadBalancerListener
      Priority: 1
      Conditions:
        - Field: path-pattern
          Values:
            - "/"
      Actions:
        - Type: redirect
          RedirectConfig:
            Path: "/KOTH/"
            StatusCode: HTTP_301
  RootRedirectRuleHttps:
    Type: AWS::ElasticLoadBalancingV2::ListenerRule
    Properties:
      ListenerArn:
        Ref: AWSEBV2LoadBalancerListener443
      Priority: 1
      Conditions:
        - Field: path-pattern
          Values:
            - "/"
      Actions:
        - Type: redirect
          RedirectConfig:
            Path: "/KOTH/"
            StatusCode: HTTP_301
