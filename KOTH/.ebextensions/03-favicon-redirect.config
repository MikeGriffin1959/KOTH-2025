# Browsers request <origin>/favicon.ico for the tab icon, but the app lives at
# /KOTH so that hits the load balancer root (404). Redirect /favicon.ico to the
# app's icon on both the HTTP(80) and HTTPS(443) listeners so the tab favicon
# resolves regardless of which page is open.
Resources:
  FaviconRuleHttp:
    Type: AWS::ElasticLoadBalancingV2::ListenerRule
    Properties:
      ListenerArn:
        Ref: AWSEBV2LoadBalancerListener
      Priority: 2
      Conditions:
        - Field: path-pattern
          Values:
            - "/favicon.ico"
      Actions:
        - Type: redirect
          RedirectConfig:
            Path: "/KOTH/KOTH-Tab-Icon.png"
            StatusCode: HTTP_301
  FaviconRuleHttps:
    Type: AWS::ElasticLoadBalancingV2::ListenerRule
    Properties:
      ListenerArn:
        Ref: AWSEBV2LoadBalancerListener443
      Priority: 2
      Conditions:
        - Field: path-pattern
          Values:
            - "/favicon.ico"
      Actions:
        - Type: redirect
          RedirectConfig:
            Path: "/KOTH/KOTH-Tab-Icon.png"
            StatusCode: HTTP_301
