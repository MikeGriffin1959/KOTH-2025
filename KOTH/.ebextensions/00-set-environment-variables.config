option_settings:
  aws:elasticbeanstalk:application:environment:
    # Datasource (SPRING_DATASOURCE_*) and the Anthropic key (COMMENTARY_API_KEY)
    # are intentionally NOT set here. They are configured as Elastic Beanstalk
    # environment properties (set out-of-band from .secrets/eb-options.json, never
    # committed) so credentials stay out of source control.
    LOGGING_LEVEL_ORG_SPRINGFRAMEWORK: INFO
    LOGGING_LEVEL_COM_ZAXXER_HIKARI: INFO
