# Raise the MIME types hash size to silence nginx's "types_hash_max_size"
# warning. Written as its own conf.d file (NOT the EB-managed proxy conf) and
# left for Elastic Beanstalk to pick up on its own nginx reload at the end of
# the deploy — a manual "service nginx reload" container_command fails on a
# fresh instance because nginx isn't running yet at that hook stage.
files:
  "/etc/nginx/conf.d/00_types_hash.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      types_hash_max_size 2048;
      types_hash_bucket_size 128;
